<Window x:Class="MeshDrive.Windows.SyncWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeshDrive · 선택 폴더 동기화" Width="980" Height="780" MinWidth="840" MinHeight="680" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24">
    <TextBlock DockPanel.Dock="Top" Text="선택 폴더 동기화 · 충돌과 이전 버전 보존" FontSize="24" Margin="0,0,0,16"/>
    <TextBlock x:Name="Feedback" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,12,0,0"/>
    <TabControl>
      <TabItem Header="동기화 허용 폴더">
        <DockPanel Margin="16">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="일반 공유와 별개입니다. 여기에 등록하고 허용한 기기는 동기화 규칙에 따라 파일을 생성·수정·삭제할 수 있습니다." TextWrapping="Wrap" Margin="0,0,0,12"/>
            <WrapPanel><Button Content="새 폴더 선택" Click="Choose_Click"/><TextBox x:Name="FolderPath" Width="420" IsReadOnly="True"/><TextBox x:Name="Alias" Width="180" Margin="8,0" ToolTip="폴더 별칭"/></WrapPanel>
            <TextBlock Text="동기화를 허용할 기기 (복수 선택)" Margin="0,12,0,6"/>
            <ListBox x:Name="Allowed" DisplayMemberPath="Name" SelectionMode="Multiple" Height="90"/>
            <WrapPanel Margin="0,12"><Button Content="허용 폴더 저장" Click="SaveRoot_Click"/><Button Content="선택 폴더 동기화 해제" Click="RemoveRoot_Click"/></WrapPanel>
          </StackPanel>
          <ListView x:Name="Roots" SelectionChanged="RootChanged"><ListView.View><GridView>
            <GridViewColumn Header="이름" Width="180" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="내 폴더" Width="600" DisplayMemberBinding="{Binding LocalPath}"/>
          </GridView></ListView.View></ListView>
        </DockPanel>
      </TabItem>
      <TabItem Header="동기화 규칙">
        <DockPanel Margin="16">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="양쪽 기기에서 폴더와 상대 기기를 먼저 허용하세요. 활성 규칙은 Agent에서 30초마다 변경을 확인합니다." TextWrapping="Wrap" Margin="0,0,0,12"/>
            <WrapPanel><TextBlock Text="내 폴더"/><ComboBox x:Name="LocalRoot" Width="200" DisplayMemberPath="Name" Margin="8,0"/><TextBlock Text="상대 기기"/><ComboBox x:Name="Device" Width="200" DisplayMemberPath="Name" SelectionChanged="DeviceChanged" Margin="8,0"/></WrapPanel>
            <WrapPanel Margin="0,12"><TextBlock Text="상대 폴더"/><ComboBox x:Name="RemoteRoot" Width="200" DisplayMemberPath="Name" Margin="8,0"/><ComboBox x:Name="Mode" Width="180" SelectedIndex="0"><ComboBoxItem Content="양방향"/><ComboBoxItem Content="내 폴더 → 상대"/><ComboBoxItem Content="상대 → 내 폴더"/></ComboBox><CheckBox x:Name="Enabled" Content="자동 동기화" IsChecked="True" Margin="12,0"/></WrapPanel>
            <WrapPanel><Button Content="새 규칙" Click="NewJob_Click"/><Button Content="규칙 저장" Click="SaveJob_Click"/><Button Content="선택 규칙 삭제" Click="RemoveJob_Click"/><Button Content="지금 동기화" Click="Run_Click"/><Button Content="상태 새로고침" Click="Refresh_Click"/></WrapPanel>
          </StackPanel>
          <ListView x:Name="Jobs" SelectionChanged="JobChanged" Margin="0,16,0,0"><ListView.View><GridView>
            <GridViewColumn Header="내 폴더" Width="170" DisplayMemberBinding="{Binding LocalName}"/><GridViewColumn Header="상대 기기" Width="170" DisplayMemberBinding="{Binding DeviceName}"/>
            <GridViewColumn Header="방향" Width="130" DisplayMemberBinding="{Binding Direction}"/><GridViewColumn Header="상태" Width="310" DisplayMemberBinding="{Binding State}"/>
          </GridView></ListView.View></ListView>
        </DockPanel>
      </TabItem>
      <TabItem Header="이전 버전 복원">
        <DockPanel Margin="16">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="동기화가 덮어쓰거나 삭제한 이전 파일을 복원합니다. 복원된 변경도 활성 규칙에 따라 다른 기기로 반영됩니다." TextWrapping="Wrap"/>
            <WrapPanel Margin="0,12"><ComboBox x:Name="VersionRoot" Width="240" DisplayMemberPath="Name" SelectionChanged="VersionRootChanged"/><Button Content="선택 버전 복원" Click="Restore_Click"/></WrapPanel>
            <WrapPanel Margin="0,12"><TextBlock Text="파일당 보관 개수"/><TextBox x:Name="VersionCount" Width="70" Margin="8,0"/><TextBlock Text="보관 일수"/><TextBox x:Name="RetentionDays" Width="70" Margin="8,0"/><Button Content="보관 설정 저장" Click="Retention_Click"/></WrapPanel>
          </StackPanel>
          <ListView x:Name="Versions"><ListView.View><GridView>
            <GridViewColumn Header="파일" Width="360" DisplayMemberBinding="{Binding Path}"/><GridViewColumn Header="보관 시각" Width="240" DisplayMemberBinding="{Binding CreatedAt}"/><GridViewColumn Header="크기" Width="150" DisplayMemberBinding="{Binding Size}"/>
          </GridView></ListView.View></ListView>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
