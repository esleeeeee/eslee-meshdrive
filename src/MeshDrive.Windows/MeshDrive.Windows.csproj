<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MeshDrive.Windows</RootNamespace>
    <AssemblyName>MeshDrive.Windows</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MeshDrive.Core\MeshDrive.Core.csproj" />
    <ProjectReference Include="..\MeshDrive.Protocol\MeshDrive.Protocol.csproj" />
    <ProjectReference Include="..\MeshDrive.Agent\MeshDrive.Agent.csproj" />
  </ItemGroup>
  <Target Name="CopyAgentRuntimeFiles" AfterTargets="Build">
    <PropertyGroup>
      <_AgentOutDir>$(MSBuildThisFileDirectory)..\MeshDrive.Agent\bin\$(Configuration)\$(TargetFramework)\</_AgentOutDir>
    </PropertyGroup>
    <ItemGroup>
      <_AgentRuntime Include="$(_AgentOutDir)*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_AgentRuntime)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
</Project>
