<Window x:Class="MeshDrive.Windows.StorageWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeshDrive · 파일과 공유 폴더" Width="1100" Height="760" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="24">
    <TextBlock DockPanel.Dock="Top" Text="파일과 공유 폴더" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,16"/>
    <TextBlock x:Name="Feedback" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,12,0,0"/>
    <TabControl>
      <TabItem Header="원격 파일">
        <DockPanel Margin="16">
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <ComboBox x:Name="Devices" Width="200" DisplayMemberPath="Name" SelectionChanged="DeviceChanged"/>
            <ComboBox x:Name="RemoteShares" Width="200" DisplayMemberPath="Name" SelectionChanged="ShareChanged" Margin="8,0"/>
            <Button Content="상위 폴더" Click="Parent_Click"/><Button Content="새로고침" Click="Reload_Click"/>
          </WrapPanel>
          <TextBlock x:Name="Location" DockPanel.Dock="Top" Margin="0,0,0,12"/>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12"><Button Content="선택 파일 열기" Click="OpenFile_Click"/><Button Content="음악 플레이어 설정" Click="MusicPlayer_Click"/><Button Content="영상 플레이어 설정" Click="VideoPlayer_Click"/></WrapPanel>
          <ListView x:Name="Entries" MouseDoubleClick="EntryDoubleClick">
            <ListView.ContextMenu><ContextMenu><MenuItem Header="연결 프로그램으로 열기" Click="OpenWith_Click"/></ContextMenu></ListView.ContextMenu>
            <ListView.View><GridView>
              <GridViewColumn Header="이름" Width="360" DisplayMemberBinding="{Binding Name}"/>
              <GridViewColumn Header="폴더" Width="70" DisplayMemberBinding="{Binding IsDirectory}"/>
              <GridViewColumn Header="크기 (바이트)" Width="130" DisplayMemberBinding="{Binding Length}"/>
              <GridViewColumn Header="수정 시각" Width="220" DisplayMemberBinding="{Binding ModifiedAt}"/>
            </GridView></ListView.View>
          </ListView>
        </DockPanel>
      </TabItem>
      <TabItem Header="내 공유 폴더">
        <DockPanel Margin="16">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="직접 등록한 폴더만 공유됩니다. 폴더 제거는 공유 해제이며 원본은 보존됩니다." TextWrapping="Wrap" Margin="0,0,0,12"/>
            <WrapPanel><Button Content="폴더 선택" Click="ChooseFolder_Click"/><TextBox x:Name="FolderPath" Width="380" IsReadOnly="True"/><TextBox x:Name="Alias" Width="180" Margin="8,0" ToolTip="표시 이름"/></WrapPanel>
            <WrapPanel Margin="0,12"><ComboBox x:Name="Preset" Width="180" SelectedIndex="0"><ComboBoxItem Content="읽기 전용"/><ComboBoxItem Content="양방향 복사"/><ComboBoxItem Content="스트리밍 전용"/></ComboBox><Button Content="공유 저장" Click="SaveShare_Click"/><Button Content="선택 공유 해제" Click="RemoveShare_Click"/></WrapPanel>
          </StackPanel>
          <ListView x:Name="LocalShares" SelectionChanged="LocalShareChanged"><ListView.View><GridView>
            <GridViewColumn Header="이름" Width="180" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="내 폴더" Width="460" DisplayMemberBinding="{Binding LocalPath}"/><GridViewColumn Header="권한" Width="180" DisplayMemberBinding="{Binding Permissions}"/>
          </GridView></ListView.View></ListView>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
