<Window x:Class="MeshDrive.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eslee MeshDrive"
        Width="900" Height="800"
        MinWidth="800" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="160" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="eslee" FontSize="14" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
            <TextBlock Text="MeshDrive" FontSize="28" FontWeight="SemiBold" Margin="0,2,0,0" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                       Text="내 기기를 연결하고 공유 폴더의 파일을 원본 그대로 사용하세요." />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#6B7380" VerticalAlignment="Center" />
                <TextBlock x:Name="ConnectionText" Text="연결 대기" FontSize="16" FontWeight="SemiBold"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Expander Grid.Row="2" Header="연결 진단 (고급)" Margin="0,14,0,0">
        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource MutedText}" Text="Agent 프로세스 ID" />
                <TextBlock x:Name="ProcessIdText" Grid.Column="1" Text="-" FontWeight="SemiBold" />

                <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" Text="시작 시각" Margin="0,10,0,0" />
                <TextBlock x:Name="StartedAtText" Grid.Row="1" Grid.Column="1" Text="-" Margin="0,10,0,0" />

                <TextBlock Grid.Row="2" Style="{StaticResource MutedText}" Text="업타임" Margin="0,10,0,0" />
                <TextBlock x:Name="UptimeText" Grid.Row="2" Grid.Column="1" Text="-" Margin="0,10,0,0" />

                <TextBlock Grid.Row="3" Style="{StaticResource MutedText}" Text="프로토콜 버전" Margin="0,10,0,0" />
                <TextBlock x:Name="ProtocolText" Grid.Row="3" Grid.Column="1" Text="-" Margin="0,10,0,0" />

                <TextBlock Grid.Row="4" Style="{StaticResource MutedText}" Text="앱 버전" Margin="0,10,0,0" />
                <TextBlock x:Name="VersionText" Grid.Row="4" Grid.Column="1" Text="-" Margin="0,10,0,0" />

                <TextBlock Grid.Row="5" Style="{StaticResource MutedText}" Text="이 PC" Margin="0,10,0,0" />
                <TextBlock x:Name="DeviceNameText" Grid.Row="5" Grid.Column="1" Text="-" Margin="0,10,0,0" />

                <TextBlock Grid.Row="6" Style="{StaticResource MutedText}" Text="기기 발견" Margin="0,10,0,0" />
                <TextBlock x:Name="DiscoveryText" Grid.Row="6" Grid.Column="1" Text="-" Margin="0,10,0,0" />
            </Grid>
        </Border>

        </Expander>
        <Border Grid.Row="3" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button x:Name="PairButton" Content="연결 요청" DockPanel.Dock="Right"
                            Click="Pair_Click" Margin="8,0,0,0" IsEnabled="False" />
                    <TextBlock Text="주변 MeshDrive" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border x:Name="PairingBanner" Background="#3A3020" BorderBrush="#7A6230"
                            BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="PairingPeerText" FontWeight="SemiBold" Foreground="#FFE1A0" />
                            <TextBlock x:Name="PairingSasText" FontSize="28" FontWeight="SemiBold"
                                       Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,10"
                                       Text="양쪽 화면에 같은 번호가 보이면 승인하세요." />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="승인" Style="{StaticResource AccentButton}" Click="ApprovePairing_Click" />
                                <Button Content="거절" Style="{StaticResource DangerButton}" Click="RejectPairing_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ListView x:Name="PeerList" Grid.Row="1" Margin="0,12,0,0"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{StaticResource TextBrush}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionChanged="PeerList_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="이름" Width="180" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="상태" Width="80" DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="신뢰" Width="90" DisplayMemberBinding="{Binding Trust}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock x:Name="EmptyPeersText" Grid.Row="1" Margin="0,44,0,0"
                               Style="{StaticResource MutedText}"
                               Text="아직 발견된 MeshDrive 기기가 없습니다." />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button x:Name="UnpairButton" Content="연결 해제" DockPanel.Dock="Right"
                            Style="{StaticResource DangerButton}" Click="Unpair_Click" IsEnabled="False" />
                    <TextBlock Text="신뢰된 기기" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ListView x:Name="TrustedList" Grid.Row="1" Margin="0,12,0,0"
                          Background="Transparent" BorderThickness="0"
                          Foreground="{StaticResource TextBrush}"
                          SelectionChanged="TrustedList_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="이름" Width="220" DisplayMemberBinding="{Binding Name}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <TextBlock x:Name="MessageText" Grid.Row="5" Style="{StaticResource MutedText}" Margin="0,16,0,0"
                   Text="창을 닫아도 Agent는 계속 실행됩니다. 다시 실행하면 같은 Agent에 재연결합니다." />

        <WrapPanel Grid.Row="6" Margin="0,18,0,0">
            <Button Content="파일과 공유 폴더" Click="OpenStorage_Click" DockPanel.Dock="Left" />
            <Button x:Name="RefreshButton" Content="상태 새로고침" Click="Refresh_Click"
                    DockPanel.Dock="Left" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="창 닫기 (Agent 유지)" Click="CloseWindow_Click" Margin="0,0,8,0" />
                <Button x:Name="ExitAllButton" Content="MeshDrive 종료" Style="{StaticResource DangerButton}"
                        Click="ExitAll_Click" />
            </StackPanel>
        </WrapPanel>
    </Grid>
</Window>
