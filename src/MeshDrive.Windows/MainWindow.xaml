<Window x:Class="MeshDrive.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="eslee MeshDrive"
        Width="680" Height="680"
        MinWidth="600" MinHeight="580"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="eslee" FontSize="14" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
            <TextBlock Text="MeshDrive" FontSize="28" FontWeight="SemiBold" Margin="0,2,0,0" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,0"
                       Text="Phase 1 — Agent가 같은 공유기에서 MeshDrive 기기를 mDNS로 찾습니다." />
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#6B7380" VerticalAlignment="Center" />
                <TextBlock x:Name="ConnectionText" Text="연결 대기" FontSize="16" FontWeight="SemiBold"
                           Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource MutedText}" Text="Agent 프로세스 ID" />
                <TextBlock x:Name="ProcessIdText" Grid.Column="1" Text="-" FontWeight="SemiBold" />

                <TextBlock Grid.Row="1" Style="{StaticResource MutedText}" Text="시작 시각" Margin="0,10,0,0" />
                <TextBlock x:Name="StartedAtText" Grid.Row="1" Grid.Column="1" Text="-" Margin="0,10,0,0" />

                <TextBlock Grid.Row="2" Style="{StaticResource MutedText}" Text="업타임" Margin="0,10,0,0" />
                <TextBlock x:Name="UptimeText" Grid.Row="2" Grid.Column="1" Text="-" Margin="0,10,0,0" />

                <TextBlock Grid.Row="3" Style="{StaticResource MutedText}" Text="프로토콜 버전" Margin="0,10,0,0" />
                <TextBlock x:Name="ProtocolText" Grid.Row="3" Grid.Column="1" Text="-" Margin="0,10,0,0" />

                <TextBlock Grid.Row="4" Style="{StaticResource MutedText}" Text="앱 버전" Margin="0,10,0,0" />
                <TextBlock x:Name="VersionText" Grid.Row="4" Grid.Column="1" Text="-" Margin="0,10,0,0" />

                <TextBlock Grid.Row="5" Style="{StaticResource MutedText}" Text="이 PC" Margin="0,10,0,0" />
                <TextBlock x:Name="DeviceNameText" Grid.Row="5" Grid.Column="1" Text="-" Margin="0,10,0,0" />

                <TextBlock Grid.Row="6" Style="{StaticResource MutedText}" Text="기기 발견" Margin="0,10,0,0" />
                <TextBlock x:Name="DiscoveryText" Grid.Row="6" Grid.Column="1" Text="-" Margin="0,10,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="주변 MeshDrive" FontWeight="SemiBold" />
                <ListView x:Name="PeerList" Grid.Row="1" Margin="0,12,0,0"
                          Background="Transparent" BorderThickness="0"
                          Foreground="{StaticResource TextBrush}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="이름" Width="220" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="상태" Width="90" DisplayMemberBinding="{Binding Status}" />
                            <GridViewColumn Header="IPv4" Width="160" DisplayMemberBinding="{Binding Ipv4}" />
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock x:Name="EmptyPeersText" Grid.Row="1" Margin="0,44,0,0"
                           Style="{StaticResource MutedText}"
                           Text="아직 발견된 MeshDrive 기기가 없습니다." />
            </Grid>
        </Border>

        <TextBlock x:Name="MessageText" Grid.Row="4" Style="{StaticResource MutedText}" Margin="0,16,0,0"
                   Text="창을 닫아도 Agent는 계속 실행됩니다. 다시 실행하면 같은 Agent에 재연결합니다." />

        <DockPanel Grid.Row="5" Margin="0,18,0,0">
            <Button x:Name="RefreshButton" Content="상태 새로고침" Click="Refresh_Click"
                    DockPanel.Dock="Left" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="창 닫기 (Agent 유지)" Click="CloseWindow_Click" Margin="0,0,8,0" />
                <Button x:Name="ExitAllButton" Content="MeshDrive 종료" Style="{StaticResource DangerButton}"
                        Click="ExitAll_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
